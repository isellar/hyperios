[Unit]
Description=HyperiOS Agent Service
Documentation=https://github.com/isellar/hyperios
# network-online ensures nmcli and outbound API calls work at startup
After=network-online.target
Wants=network-online.target
# sway is NOT a dependency — the agent runs headlessly without a display server.
# Display management (Phase 4) is handled by the agent itself after startup.
# Limit restart attempts to avoid rapid cycling on misconfiguration.
# StartLimitIntervalSec/Burst must live in [Unit], not [Service].
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=hyperi
Group=hyperi
# Phase 0/1: cobra CLI session start
# Phase 2+: replace with 'hyperi' (persistent TUI shell)
ExecStart=/usr/local/bin/hyperi session start --execute
WorkingDirectory=/var/lib/hyperi
# API key loaded from environment file — do not hardcode in unit file
# Set ANTHROPIC_API_KEY in /etc/hyperi/environment
EnvironmentFile=-/etc/hyperi/environment
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
# strict: / is read-only; only ReadWritePaths are writable
ProtectSystem=strict
ProtectHome=read-only
# Writable paths: agent state, logs, plans, config
ReadWritePaths=/var/lib/hyperi /var/log/hyperi /etc/hyperi
PrivateTmp=yes
# Prevent the agent from gaining new capabilities via execve
CapabilityBoundingSet=
# Restrict address families — agent only needs inet (API calls) and unix (sway IPC)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Prevent writing to kernel variables
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
